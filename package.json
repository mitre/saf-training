    "playwright:run": "playwright test",
    "test:e2e": "npm run docs:build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "flowchart.ts": "^3.0.1",
    "http-server": "^14.1.1",
    "mermaid": "^12.0.0",
    "sass": "^1.104.0",
    "vue": "^3.5.42",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-hope": "2.0.0-rc.109"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
