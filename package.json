{
  "name": "saf-training",
  "version": "2.0.0",
  "description": "Training site for the MITRE Security Automation Framework",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "docs:build": "vuepress-vite build src",
    "docs:dev": "vuepress-vite dev src",
    "docs:serve": "http-server src/.vuepress/dist -a 127.0.0.1 -p 8080 -c-1 --silent",
